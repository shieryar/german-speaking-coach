# Server only. OpenAI API project with GPT-Live-1 and Responses access.
OPENAI_API_KEY=sk-your-openai-api-key
# Optional; defaults to gpt-4o-mini for structured review output.
OPENAI_REVIEW_MODEL=gpt-4o-mini

# Supabase project URL and publishable/anon key. RLS protects user data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key
